{
    "name": "kennzeichenservices/dropshipping-sdk",
    "description": "Production-ready PHP SDK for the Dropshipping API",
    "version": "2.3.20",
    "api-version": "2.3.1",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Kennzeichen Services",
            "email": "sebastian@kennzeichenservices.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Dropshipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dropshipping\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "release": "bash scripts/release.sh"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
