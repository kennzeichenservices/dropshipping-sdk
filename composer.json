{
    "name": "kennzeichenservices/dropshipping-sdk",
    "description": "Production-ready PHP SDK for the Dropshipping API",
    "version": "2.4.1",
    "api-version": "2.3.1",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Kennzeichen Services",
            "email": "sebastian@kennzeichenservices.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^7.15.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "laravel/pint": "^1.30"
    },
    "autoload": {
        "psr-4": {
            "Dropshipping\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dropshipping\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "analyse": [
            "phpstan analyse -c phpstan.neon.dist",
            "phpstan analyse -c phpstan-tests.neon.dist"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "audit:security": "composer audit",
        "bc-check": "bash scripts/bc-check.sh",
        "check": [
            "@lint",
            "@analyse",
            "@test:unit"
        ],
        "release": "bash scripts/release.sh"
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis (src at level 8, tests at level 6).",
        "lint": "Check code style without changing files.",
        "lint:fix": "Apply code style fixes.",
        "audit:security": "Report known CVEs in installed dependencies.",
        "bc-check": "Diff the public API and DTO hydration behaviour against a released tag. Run before every release.",
        "check": "Run lint, static analysis and unit tests — the pre-commit gate."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
